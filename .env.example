# Firebase Core Configuration (Web App)
# Obtain from Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check Configuration
# For local dev: leave empty or provide debug token from Firebase Console
VITE_APPCHECK_DEBUG_TOKEN=
# For production: reCAPTCHA Enterprise site key
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional Google Maps Platform API Key
VITE_GOOGLE_MAPS_API_KEY=
