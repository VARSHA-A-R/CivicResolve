rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Complaint Photographic Evidence
    match /complaint_evidence/{userId}/{fileName} {
      // Public Read: Any citizen or officer can inspect the photo evidence for public verification
      allow read: if true;

      // Authenticated Write:
      // 1. Must be authenticated
      // 2. Can only upload to their own user directory path ({userId} == request.auth.uid)
      // 3. Must be an accepted image MIME type (JPEG, PNG, WebP)
      // 4. File size strictly limited to 5MB maximum
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');

      // Deletion prevented from client
      allow delete: if false;
    }
  }
}
